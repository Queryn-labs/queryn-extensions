{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plugins.osnova.local/catalog/registry.schema.json",
  "title": "Osnova Plugin Registry",
  "type": "object",
  "required": ["plugins"],
  "additionalProperties": false,
  "properties": {
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "version", "source", "permissions", "osnova"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "source": { "type": "string", "minLength": 1 },
          "permissions": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "osnova": {
            "type": "object",
            "required": ["minVersion"],
            "additionalProperties": false,
            "properties": {
              "minVersion": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
